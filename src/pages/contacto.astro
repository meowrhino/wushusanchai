---
import Base from '../layouts/Base.astro';
import { site, contacto, direccion, horario, diasCerrados } from '../data/site.js';
---

<Base
  title="Contacto"
  seoTitle="Contacto · Instituto Wushu Sanchai · Rocafort 9, Barcelona"
  description={`Contacta con el ${site.nombre}. ${direccion.calle}, ${direccion.barrio}, Barcelona. Teléfono ${contacto.telefono}. Email ${contacto.email}.`}
>
  <section class="section page-intro">
    <div class="container container-narrow text-center">
      <p class="eyebrow">Empieza hoy tu camino</p>
      <h1>Te ayudamos a conseguir tu mejor versión</h1>
      <p class="lead">
        Si quieres probar una clase, resolver dudas o recibir más información, estamos
        aquí para ayudarte. Escríbenos y descubre cómo nuestras clases pueden cambiar
        tu vida.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="info-grid">
        <article class="info-card">
          <h3>Encuéntranos en</h3>
          <p>{direccion.calle},<br />{direccion.barrio}, {direccion.cp} {direccion.ciudad}, {direccion.pais}</p>
          <p><a href={direccion.comoLlegarUrl} target="_blank" rel="noopener noreferrer">Cómo llegar →</a></p>
        </article>

        <article class="info-card">
          <h3>Horario</h3>
          <ul>
            {horario.map((h) => <li>{h.dia}: {h.abre}h - {h.cierra}h</li>)}
            <li class="muted">{diasCerrados}</li>
          </ul>
        </article>

        <article class="info-card">
          <h3>Llámanos o escríbenos por WhatsApp</h3>
          <p class="big"><a href={`tel:${contacto.telefonoE164}`}>{contacto.telefono}</a></p>
          <p><a href={contacto.whatsapp} class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">Abrir WhatsApp</a></p>
          <h3 style="margin-top:1.25rem">Escríbenos</h3>
          <p class="big"><a href={`mailto:${contacto.email}`}>{contacto.email}</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2">
        <div>
          <p class="eyebrow">Tu primer paso empieza aquí</p>
          <h2>Déjanos tu mensaje</h2>
          <p>
            Queremos conocerte y asesorarte según tus objetivos. Déjanos tus datos y te
            responderemos lo antes posible con toda la información que necesites.
          </p>

          <form class="contact-form" action={`mailto:${contacto.email}`} method="post" enctype="text/plain">
            <label>
              Nombre
              <input type="text" name="nombre" required autocomplete="name" />
            </label>
            <label>
              Teléfono
              <input type="tel" name="telefono" autocomplete="tel" />
            </label>
            <label>
              Correo electrónico
              <input type="email" name="email" required autocomplete="email" />
            </label>
            <label>
              Mensaje
              <textarea name="mensaje" rows="5" required></textarea>
            </label>
            <button type="submit" class="btn">Enviar</button>
            <p class="note">Al enviar este formulario aceptas nuestra <a href="/politica-de-privacidad">política de privacidad</a>.</p>
          </form>
        </div>

        <div class="map">
          <iframe
            src={direccion.embedUrl}
            width="100%"
            height="100%"
            style="border:0; min-height:420px"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Mapa del ${site.nombre}`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 800px) { .info-grid { grid-template-columns: repeat(3, 1fr); } }

  .info-card {
    background: #fff;
    padding: 1.75rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .info-card h3 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }
  .info-card ul { list-style: none; padding: 0; margin: 0; }
  .info-card li { margin-bottom: 0.25rem; }
  .info-card .big { font-size: 1.15rem; font-weight: 600; }
  .info-card .big a { color: var(--color-accent); text-decoration: none; }
  .info-card .big a:hover { text-decoration: underline; }
  .info-card .muted { font-size: 0.9rem; }

  .btn-whatsapp { background: #25d366; color: #fff; }
  .btn-whatsapp:hover { background: #1da851; color: #fff; }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-heading);
  }
  .contact-form input,
  .contact-form textarea {
    font: inherit;
    font-weight: 400;
    color: var(--color-text);
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    transition: border-color 0.2s;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(224, 46, 33, 0.15);
  }
  .contact-form button { align-self: flex-start; }
  .note { font-size: 0.82rem; color: var(--color-text-muted); margin: 0; }

  .map {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    overflow: hidden;
    min-height: 420px;
  }
</style>
