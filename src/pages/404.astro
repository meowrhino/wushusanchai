---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página que buscas no existe o ha sido movida.">
  <section class="section error-section">
    <div class="container container-narrow text-center">
      <p class="big-code">404</p>
      <h1>Página no encontrada</h1>
      <p class="lead">
        La página que buscas no existe o ha sido movida. Vuelve al inicio o
        consulta nuestros entrenamientos.
      </p>
      <div class="actions">
        <a href="/" class="btn">Ir al inicio</a>
        <a href="/servicios" class="btn btn-ghost">Ver servicios</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .error-section { padding: clamp(4rem, 10vw, 7rem) 0; }
  .big-code {
    font-family: var(--font-heading);
    font-size: clamp(5rem, 15vw, 9rem);
    color: var(--color-accent);
    line-height: 1;
    margin: 0;
  }
  .actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
</style>
