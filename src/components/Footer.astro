---
import {
  site,
  contacto,
  direccion,
  direccionLinea,
  horario,
  diasCerrados,
  redes,
  navPrincipal,
  navLegal,
} from '../data/site.js';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="col brand-col">
      <img src="/img/logo.svg" alt={site.nombre} width="160" height="160" />
      <p>Escuela de kungfu, taichi y qigong. Mejora tu equilibrio, fuerza y bienestar con entrenamientos adaptados a todos los niveles.</p>
      <p class="follow">Síguenos en:</p>
      <ul class="social">
        {redes.map((r) => (
          <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.nombre}</a></li>
        ))}
      </ul>
    </div>

    <div class="col">
      <h4>Menú</h4>
      <ul>
        {navPrincipal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <h4>Legal</h4>
      <ul>
        {navLegal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="col">
      <h4>Información de contacto</h4>
      <p>
        <strong>Dirección:</strong><br />
        <a href={direccion.mapaUrl} target="_blank" rel="noopener noreferrer">
          {direccionLinea}
        </a>
      </p>
      <p>
        <strong>Horarios:</strong><br />
        {horario.map((h) => <>{`${h.dia} ${h.abre}h - ${h.cierra}h`}<br /></>)}
        <span class="muted">{diasCerrados}</span>
      </p>
      <p>
        <strong>Teléfono:</strong> <a href={`tel:${contacto.telefonoE164}`}>{contacto.telefono}</a><br />
        <strong>Correo:</strong> <a href={`mailto:${contacto.email}`}>{contacto.email}</a><br />
        <strong>WhatsApp:</strong> <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
      </p>
      <p><a href={direccion.comoLlegarUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Cómo llegar</a></p>
    </div>
  </div>

  <div class="container kit-row">
    <img src="/img/kit-digital.svg" alt="Kit Digital" width="320" />
  </div>

  <div class="container copy">
    <p>© {year} {site.nombre} · {site.nombreLegal} · CIF {site.cif}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #111;
    color: #d8d8d8;
    padding: 3.5rem 0 1.5rem;
    margin-top: 4rem;
  }
  .site-footer :global(h4) {
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 1.25rem 0 0.75rem;
  }
  .site-footer :global(h4:first-child) { margin-top: 0; }
  .site-footer :global(a) {
    color: #d8d8d8;
    text-decoration: none;
  }
  .site-footer :global(a:hover) { color: #fff; text-decoration: underline; }
  .site-footer :global(p) { margin: 0 0 0.85em; font-size: 0.92rem; line-height: 1.5; }
  .site-footer .muted { color: #888; }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 800px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1.3fr;
      gap: 3rem;
    }
  }

  .brand-col img {
    background: #fff;
    padding: 0.6rem 0.9rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }
  .follow { margin-top: 0.5rem; font-weight: 600; color: #fff; }
  .social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .col ul {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
  }
  .col li { margin-bottom: 0.4rem; font-size: 0.92rem; }

  .kit-row {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #333;
    text-align: center;
  }
  .kit-row img {
    background: #fff;
    padding: 0.75rem 1.25rem;
    border-radius: 4px;
    display: inline-block;
    max-width: 320px;
  }

  .copy {
    margin-top: 1.5rem;
    text-align: center;
    color: #888;
    font-size: 0.8rem;
  }
  /* El footer es oscuro: el botón fantasma se invierte aquí. */
  .site-footer :global(.btn-ghost) {
    color: #fff;
    border-color: #fff;
  }
  .site-footer :global(.btn-ghost:hover) {
    background: #fff;
    color: #111;
  }
</style>
