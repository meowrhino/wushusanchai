# Evita que los prototipos de prueba se indexen (refuerza el <meta robots> de cada página)
/prototipos/*
  X-Robots-Tag: noindex, nofollow

# Imágenes y fuentes: nombres estables, se revisan cada día.
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Assets con hash en el nombre: nunca cambian, cachear un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cabeceras de seguridad para todo el sitio.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
